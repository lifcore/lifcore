# Copie este arquivo para ".env" e preencha com seus valores reais.
# NUNCA suba o arquivo ".env" pro GitHub (ele já está no .gitignore).

# Supabase — encontre em Project Settings > API
VITE_SUPABASE_URL=https://seu-projeto.supabase.co
VITE_SUPABASE_ANON_KEY=sua_anon_key_aqui

# Provedor de IA ativo: "anthropic" por enquanto.
# No futuro, trocar esse valor troca o provedor sem mudar código.
VITE_AI_PROVIDER=anthropic

# Chave da API do provedor de IA escolhido acima.
# ATENÇÃO: em produção, chamadas de IA devem passar por um backend,
# nunca expor essa chave direto no navegador. Isso é só para
# desenvolvimento/testes locais nesta fase inicial.
VITE_AI_API_KEY=sua_chave_aqui
